# ICVER Backend Configuration
PROJECT_NAME="ICVER - Informal Worker Income Verification System"
VERSION="0.1.0"
API_V1_STR="/api/v1"

# Debug mode (controls FastAPI docs and SQLAlchemy SQL echo)
DEBUG=false

# Client Feature Overrides
# When false (default), client-provided model feature overrides in /score requests
# (e.g. upi_monthly_inflow, weekly_txn_frequency, etc.) are ignored, and database
# records are strictly used. When true, client overrides are accepted (used by
# what-if simulation tools such as WhatIfSimulator in the frontend).
ALLOW_FEATURE_OVERRIDES=false

# Database Connection URL (MariaDB / MySQL via PyMySQL)
DATABASE_URL=mysql+pymysql://icver_user:icver_password@localhost:3306/icver_db

# CORS Allowed Origins (comma-separated or JSON list)
# Note: Wildcard "*" will automatically disable allow_credentials for security
CORS_ORIGINS="http://localhost:5173,http://localhost:3000,http://localhost:8000,http://127.0.0.1:5173,http://127.0.0.1:3000,http://127.0.0.1:8000"
