# ICVER Backend Environment Variables Example

PROJECT_NAME="ICVER - Informal Worker Income Verification System"
VERSION="0.1.0"
DEBUG=True
API_V1_STR="/api/v1"

# Database Configuration (MariaDB / MySQL)
DATABASE_URL="mysql+pymysql://icver_user:icver_password@localhost:3306/icver_db"

# CORS Configuration (Comma-separated list or JSON format)
CORS_ORIGINS=["http://localhost:3000","http://localhost:8000"]
